htmlcov/
mnt/
resultados/
rues_linker.egg-info/
salida/
src/rues_linker.egg-info/
venv/
work/


# ── Archivos específicos excluidos ────────────────────────────────────
.coverage
coverage.xml
setup.cfg
setup.py


# ── Carpetas de trabajo personal ──────────────────────────────────────
z. */
z.*/


# ── IDE ───────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db


# ── Credenciales ──────────────────────────────────────────────────────
.env
.env.local
secrets.json
*_token.txt
*.pem
*.key


# ── Excepciones (siempre incluir) ────────────────────────────────
# Estas reglas DEBEN ser las últimas del archivo.
# En .gitignore la última coincidencia gana; si una regla
# de exclusión aparece después de una excepción, la anula.
# Primero los directorios versionados, luego los archivos sueltos:
# git no desciende a un directorio ignorado.
